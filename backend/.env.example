DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gps_tracker?schema=public"
PORT=3001
NODE_ENV=development
JWT_SECRET=demo-jwt-secret-change-in-production

# --- Consola de Dueño (SuperAdmin) ---
# Cuenta creada al arrancar si no existe (contraseña mínimo 12 caracteres)
OWNER_EMAIL=owner@floagps.com
OWNER_PASSWORD=
# Clave maestra (2do factor) para entrar a la consola y para acciones destructivas. Mínimo 16 caracteres en producción.
OWNER_MASTER_KEY=
# Duración de la sesión del dueño
OWNER_TOKEN_TTL=8h
# Opcional: lista de IPs permitidas para la consola, separadas por coma (vacío = cualquier IP)
OWNER_ALLOWED_IPS=

# --- Correo (recuperación de contraseña) ---
# Opción A (sin dominio propio): Gmail SMTP con "contraseña de aplicación".
#   Requiere verificación en 2 pasos en la cuenta de Google. Límite ~500 correos/día.
SMTP_USER=
SMTP_PASS=
# Opcionales (por defecto Gmail): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
# Opción B: Resend (https://resend.com). Sin dominio verificado solo entrega al correo dueño de la cuenta.
RESEND_API_KEY=
# Remitente. Con Gmail déjalo vacío (se usa la cuenta SMTP). Con Resend usa tu dominio verificado.
EMAIL_FROM=
# Sin ninguna opción configurada, en desarrollo el código se imprime en la consola del backend.

# El receptor TCP GT06 es un servicio aparte (npm run tracker) con su propia
# configuracion en .env.production.example

# --- Puente Traccar (dispositivos reales, p.ej. Cellocator CR-300B) ---
# Deja TRACCAR_URL vacio para desactivar el puente.
TRACCAR_URL=
TRACCAR_TOKEN=
TRACCAR_USER=
TRACCAR_PASSWORD=
TRACCAR_POLL_MS=15000
TRACCAR_LOOKBACK_MS=3600000

