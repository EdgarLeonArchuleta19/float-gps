generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  contactEmail String?
  contactPhone String?
  plan         String      @default("PRO")
  maxUnits     Int         @default(50)
  isActive     Boolean     @default(true)
  notes        String?
  workStartHour Int        @default(7)
  workEndHour   Int        @default(19)
  workDays      String     @default("1,2,3,4,5,6")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  users        User[]
  vehicles     Vehicle[]
  machines     Machine[]
  geofences    Geofence[]
  gpsDevices   GpsDevice[]
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         String     @default("admin")
  companyId    String?
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeAttempts  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  company      Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  units        UserUnit[]

  @@index([companyId])
}

model OwnerAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  success    Boolean  @default(true)
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model UserUnit {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String?
  machineId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GpsDevice {
  id           String          @id @default(uuid())
  imei         String          @unique
  model        String
  simNumber    String?
  isActive     Boolean         @default(true)
  lastReportAt DateTime?
  companyId    String?
  vehicleId    String?         @unique
  machineId    String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id])
  machine      Machine?        @relation(fields: [machineId], references: [id])
  positions    GpsPosition[]
  events       TrackingEvent[]

  @@index([companyId])
}

model Vehicle {
  id           String        @id @default(uuid())
  name         String
  plate        String
  type         String
  brand        String?
  vehicleModel String?
  year         Int?
  color        String?
  status       String        @default("OFFLINE")
  isActive     Boolean       @default(true)
  companyId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  gpsDevice    GpsDevice?
  userUnits    UserUnit[]
  workSessions WorkSession[]

  @@index([companyId])
}

model Machine {
  id           String        @id @default(uuid())
  name         String
  serialNumber String?
  type         String
  brand        String?
  machineModel String?
  year         Int?
  status       String        @default("OFFLINE")
  isActive     Boolean       @default(true)
  companyId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  gpsDevice    GpsDevice?
  userUnits    UserUnit[]
  workSessions WorkSession[]

  @@index([companyId])
}

model GpsPosition {
  id          String    @id @default(uuid())
  latitude    Float
  longitude   Float
  speed       Float     @default(0)
  altitude    Float?
  heading     Float?
  satellites  Int?
  ignition    Boolean   @default(false)
  voltage     Float?
  odometer    Float?
  timestamp   DateTime
  gpsDeviceId String
  createdAt   DateTime  @default(now())
  gpsDevice   GpsDevice @relation(fields: [gpsDeviceId], references: [id], onDelete: Cascade)

  @@index([gpsDeviceId, timestamp])
  @@index([timestamp])
}

model IgnitionEvent {
  id        String   @id @default(uuid())
  type      String
  timestamp DateTime
  latitude  Float?
  longitude Float?
  vehicleId String?
  machineId String?
  createdAt DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@index([machineId, timestamp])
}

model Geofence {
  id        String          @id @default(uuid())
  name      String
  type      String
  color     String          @default("#3B82F6")
  isActive  Boolean         @default(true)
  radius    Float?
  centerLat Float?
  centerLng Float?
  points    String?
  companyId String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  events    GeofenceEvent[]

  @@index([companyId])
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  type       String
  timestamp  DateTime
  latitude   Float
  longitude  Float
  unitName   String
  unitType   String
  geofenceId String
  createdAt  DateTime @default(now())
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([geofenceId, timestamp])
}

model TrackingEvent {
  id          String    @id @default(uuid())
  type        String
  severity    String    @default("INFO")
  message     String?
  latitude    Float?
  longitude   Float?
  speed       Float?
  timestamp   DateTime
  gpsDeviceId String
  createdAt   DateTime  @default(now())
  gpsDevice   GpsDevice @relation(fields: [gpsDeviceId], references: [id], onDelete: Cascade)

  @@index([gpsDeviceId, timestamp])
  @@index([type, timestamp])
}

model WorkSession {
  id          String    @id @default(uuid())
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  totalHours  Float     @default(0)
  kilometers  Float     @default(0)
  idleHours   Float     @default(0)
  movingHours Float     @default(0)
  vehicleId   String?
  machineId   String?
  createdAt   DateTime  @default(now())
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  machine     Machine?  @relation(fields: [machineId], references: [id])

  @@index([vehicleId, date])
  @@index([machineId, date])
}
