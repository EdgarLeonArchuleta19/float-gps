generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  contactEmail    String?
  contactPhone    String?
  plan            String           @default("EMPRESA")
  maxUnits        Int              @default(50)
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  notes           String?
  legalName       String?
  taxId           String?
  address         String?
  website         String?
  logo            String?
  workSchedule    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  vehicles        Vehicle[]
  machines        Machine[]
  geofences       Geofence[]
  gpsDevices      GpsDevice[]
  roles           Role[]
  subscription    Subscription?
  supportSessions SupportSession[]
  unitGroups      UnitGroup[]
  maintenances    Maintenance[]
}

model UnitGroup {
  id              String           @id @default(uuid())
  name            String
  nameKey         String
  color           String           @default("#032347")
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicles        Vehicle[]
  machines        Machine[]
  geofenceTargets GeofenceTarget[]

  @@unique([companyId, nameKey])
}

model UserUnit {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String?
  machineId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeofenceTarget {
  id         String     @id @default(uuid())
  geofenceId String
  vehicleId  String?
  machineId  String?
  groupId    String?
  geofence   Geofence   @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  machine    Machine?   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  group      UnitGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([geofenceId])
}

model NotificationSetting {
  id           String   @id @default(uuid())
  userId       String   @unique
  pushEnabled  Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  types        String[] @default(["GEOFENCE", "SOS", "OVERSPEED", "MAINTENANCE"])
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  kind       String
  token      String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Maintenance {
  id             String           @id @default(uuid())
  companyId      String
  vehicleId      String?
  machineId      String?
  kind           String
  title          String
  intervalKm     Float?
  intervalDays   Int?
  lastDoneAt     DateTime
  notes          String?
  notifiedStatus String?
  notifiedAt     DateTime?
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  machine        Machine?         @relation(fields: [machineId], references: [id], onDelete: Restrict)
  logs           MaintenanceLog[]

  @@index([companyId])
}

model MaintenanceLog {
  id            String      @id @default(uuid())
  maintenanceId String
  doneAt        DateTime
  km            Float?
  cost          Float?
  notes         String?
  doneBy        String
  createdAt     DateTime    @default(now())
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Restrict)

  @@index([maintenanceId, doneAt])
}

model StaffUser {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  password        String
  role            String
  isActive        Boolean          @default(true)
  tokenVersion    Int              @default(0)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  supportSessions SupportSession[]
}

model SupportSession {
  id        String    @id @default(uuid())
  staffId   String
  companyId String
  reason    String
  ip        String?
  startedAt DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Restrict)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, startedAt])
  @@index([staffId, startedAt])
}

model Subscription {
  id            String    @id @default(uuid())
  companyId     String    @unique
  status        String    @default("ACTIVE")
  billingCycle  String    @default("MONTHLY")
  pricePerUnit  Float     @default(0)
  currency      String    @default("MXN")
  startedAt     DateTime  @default(now())
  nextBillingAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String
  role                String               @default("admin")
  roleId              String?
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  companyId           String?
  tokenVersion        Int                  @default(0)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  resetCodeHash       String?
  resetCodeExpiresAt  DateTime?
  resetCodeAttempts   Int                  @default(0)
  mustChangePassword  Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ownUnits            Boolean              @default(false)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customRole          Role?                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  units               UserUnit[]
  notificationSetting NotificationSetting?
  pushDevices         PushDevice[]

  @@index([companyId])
  @@index([roleId])
}

model Role {
  id          String     @id @default(uuid())
  name        String
  nameKey     String?
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  permissions String[]
  allUnits    Boolean    @default(true)
  systemKey   String?
  companyId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  units       RoleUnit[]

  @@unique([companyId, nameKey])
  @@unique([companyId, systemKey])
}

model StaffAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String
  actorRole  String?
  companyId  String?
  action     String
  targetType String?
  targetId   String?
  success    Boolean  @default(true)
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([companyId, createdAt])
  @@map("OwnerAuditLog")
}

model RoleUnit {
  id        String   @id @default(uuid())
  roleId    String
  vehicleId String?
  machineId String?
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([roleId])
}

model GpsDevice {
  id           String          @id @default(uuid())
  imei         String          @unique
  model        String
  simNumber    String?
  isActive     Boolean         @default(true)
  deletedAt    DateTime?
  lastReportAt DateTime?
  companyId    String?
  vehicleId    String?         @unique
  machineId    String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id])
  machine      Machine?        @relation(fields: [machineId], references: [id])
  positions    GpsPosition[]
  events       TrackingEvent[]

  @@index([companyId])
}

model Vehicle {
  id              String           @id @default(uuid())
  name            String
  plate           String
  type            String
  brand           String?
  vehicleModel    String?
  year            Int?
  color           String?
  figure          String?
  iconColor       String?
  status          String           @default("OFFLINE")
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  gpsDevice       GpsDevice?
  roleUnits       RoleUnit[]
  workSessions    WorkSession[]
  groupId         String?
  group           UnitGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userUnits       UserUnit[]
  geofenceTargets GeofenceTarget[]
  maintenances    Maintenance[]

  @@index([companyId])
}

model Machine {
  id              String           @id @default(uuid())
  name            String
  serialNumber    String?
  type            String
  brand           String?
  machineModel    String?
  year            Int?
  status          String           @default("OFFLINE")
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  gpsDevice       GpsDevice?
  roleUnits       RoleUnit[]
  workSessions    WorkSession[]
  groupId         String?
  group           UnitGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userUnits       UserUnit[]
  geofenceTargets GeofenceTarget[]
  maintenances    Maintenance[]

  @@index([companyId])
}

model GpsPosition {
  id          String    @id @default(uuid())
  latitude    Float
  longitude   Float
  speed       Float     @default(0)
  altitude    Float?
  heading     Float?
  satellites  Int?
  ignition    Boolean   @default(false)
  voltage     Float?
  odometer    Float?
  timestamp   DateTime
  gpsDeviceId String
  createdAt   DateTime  @default(now())
  gpsDevice   GpsDevice @relation(fields: [gpsDeviceId], references: [id], onDelete: Cascade)

  @@index([gpsDeviceId, timestamp])
  @@index([timestamp])
}

model IgnitionEvent {
  id        String   @id @default(uuid())
  type      String
  timestamp DateTime
  latitude  Float?
  longitude Float?
  vehicleId String?
  machineId String?
  createdAt DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@index([machineId, timestamp])
}

model Geofence {
  id        String           @id @default(uuid())
  name      String
  type      String
  color     String           @default("#3B82F6")
  isActive  Boolean          @default(true)
  deletedAt DateTime?
  radius    Float?
  centerLat Float?
  centerLng Float?
  points    String?
  companyId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  events    GeofenceEvent[]
  alertOn   String           @default("BOTH")
  allUnits  Boolean          @default(true)
  targets   GeofenceTarget[]

  @@index([companyId])
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  type       String
  timestamp  DateTime
  latitude   Float
  longitude  Float
  unitName   String
  unitType   String
  geofenceId String
  createdAt  DateTime @default(now())
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([geofenceId, timestamp])
}

model TrackingEvent {
  id          String    @id @default(uuid())
  type        String
  severity    String    @default("INFO")
  message     String?
  latitude    Float?
  longitude   Float?
  speed       Float?
  timestamp   DateTime
  gpsDeviceId String
  createdAt   DateTime  @default(now())
  gpsDevice   GpsDevice @relation(fields: [gpsDeviceId], references: [id], onDelete: Cascade)

  @@index([gpsDeviceId, timestamp])
  @@index([type, timestamp])
}

model WorkSession {
  id          String    @id @default(uuid())
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  totalHours  Float     @default(0)
  kilometers  Float     @default(0)
  idleHours   Float     @default(0)
  movingHours Float     @default(0)
  vehicleId   String?
  machineId   String?
  createdAt   DateTime  @default(now())
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  machine     Machine?  @relation(fields: [machineId], references: [id])

  @@index([vehicleId, date])
  @@index([machineId, date])
}
