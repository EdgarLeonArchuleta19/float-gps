# Configuracion del receptor GT06 contra PRODUCCION.
#
# Copia este archivo a ".env.production" (el real esta en .gitignore, no se commitea):
#   cp .env.production.example .env.production
#
# El API y el tracker son servicios separados:
#   - .env            -> desarrollo local (Postgres en localhost)
#   - .env.production -> produccion (Neon)
#
# Donde conseguir el valor: console.neon.tech -> tu proyecto -> Connect.
# En Vercel la variable se llama DATABASE_URL pero esta marcada "Secret",
# por eso no se puede leer desde ahi.
#
# Nota: el tracker toma la BD con esta precedencia
#   1. TRACKER_DATABASE_URL del entorno
#   2. .env.production
#   3. .env

TRACKER_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Red ---
# GT06 usa el puerto 5001 por defecto
TRACKER_PORT=5001
TRACKER_HOST=0.0.0.0

# --- Umbrales que generan eventos ---
TRACKER_OVERSPEED_KMH=80
TRACKER_LOW_BATTERY_V=11.5
TRACKER_MAX_AGE_H=48

# --- Operacion ---
# Minutos sin reportes antes de marcar la unidad como OFFLINE
TRACKER_OFFLINE_MIN=15
# false deja de guardar los paquetes crudos en tracker_captures/
TRACKER_CAPTURE=true
