{
  "expo": {
    "name": "floaGPS",
    "slug": "floa-gps",
    "version": "1.0.0",
    "scheme": "floagps",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131316",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.floa.gps",
      "infoPlist": {
        "NSFaceIDUsageDescription": "floaGPS usa Face ID para confirmar comandos de paro de motor.",
        "NSLocationWhenInUseUsageDescription": "floaGPS usa tu ubicación para centrar el mapa y calcular rutas hacia tus unidades."
      }
    },
    "android": {
      "package": "com.floa.gps",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "floaGPS",
      "shortName": "floaGPS",
      "themeColor": "#032347",
      "backgroundColor": "#131316"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "floaGPS usa Face ID para confirmar comandos de paro de motor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "floaGPS usa tu ubicación para centrar el mapa y calcular rutas hacia tus unidades."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#032347"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "floaGPS usa tus fotos para que elijas el logo de tu empresa.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b574a87b-9bb2-4201-afab-c57fba9e7341"
      }
    },
    "owner": "edgarleonarchuleta"
  }
}
