# ==========================================
# Variables de entorno - Infraestructura Floa GPS
# ==========================================

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=genera_una_contrasena_segura_aqui
POSTGRES_DB=gps_tracker

# Seguridad API
JWT_SECRET=genera_un_jwt_secret_largo_y_seguro_aqui
OWNER_MASTER_KEY=genera_una_clave_maestra_de_16_o_mas_caracteres
CORS_ORIGINS=https://tu-dominio-pwa.pages.dev,http://localhost:5173

# Secreto para el webhook interno Traccar -> API
# Mínimo 24 caracteres; genéralo con: openssl rand -hex 32
TRACCAR_WEBHOOK_SECRET=genera_un_secreto_para_webhook_de_24_o_mas

# Credenciales de administración Traccar
TRACCAR_ADMIN_USER=admin
TRACCAR_ADMIN_PASSWORD=cambia_esta_clave_admin

# Token de Cloudflare Tunnel (gratis en dash.cloudflare.com -> Zero Trust -> Access -> Tunnels)
TUNNEL_TOKEN=tu_token_de_cloudflare_tunnel_aqui
